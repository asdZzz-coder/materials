<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

  <!--
    直接把要測的原始碼編進測試專案，而不是參考 MaterialsKeeper.dll：
    這台電腦的「智慧型應用程式控制」會擋下測試程式載入未簽章的 dll。
  -->
  <ItemGroup>
    <Compile Include="..\materials\Services\DesktopShortcutService.cs" Link="Source\DesktopShortcutService.cs" />
    <Compile Include="..\materials\Services\ThemeService.cs" Link="Source\ThemeService.cs" />
    <Compile Include="..\materials\Services\DataStore.cs" Link="Source\DataStore.cs" />
    <Compile Include="..\materials\Services\CategoryService.cs" Link="Source\CategoryService.cs" />
    <Compile Include="..\materials\Services\QuantityText.cs" Link="Source\QuantityText.cs" />
    <Compile Include="..\materials\Services\ExcelService.cs" Link="Source\ExcelService.cs" />
    <Compile Include="..\materials\Models\MaterialItem.cs" Link="Source\MaterialItem.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
